{
  "name": "appui",
  "version": "0.1.0",
  "description": "Free open-source UI components for React and Next.js — live at opensourceui.in",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bidyut10/opensourceui.git"
  },
  "homepage": "https://opensourceui.in",
  "bugs": {
    "url": "https://github.com/bidyut10/opensourceui/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "npm run check:showcase",
    "start": "next start",
    "lint": "eslint",
    "check:showcase": "node scripts/check-showcase-files.mjs",
    "pages:dev": "npm run build && npx wrangler pages dev out",
    "pages:deploy": "npx wrangler pages deploy out --project-name=opensourceui"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "next": "16.2.7",
    "postcss": "^8.5.15",
    "posthog-js": "^1.399.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5",
    "wrangler": "^4.127.0"
  }
}
