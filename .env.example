# Copy to .env.local for local testing.
#
# Cloudflare Pages → Settings → Environment variables (set for Production + Preview):
#   NEXT_PUBLIC_POSTHOG_KEY, NEXT_PUBLIC_POSTHOG_HOST, NEXT_PUBLIC_POSTHOG_UI_HOST
#   GOOGLE_SITE_VERIFICATION (optional)
#
# Cloudflare Pages → Settings → Builds:
#   Framework: Next.js (Static HTML Export)  — not plain "Next.js" (that runs OpenNext)
#   Build command: npm run build
#   Output directory: out

# --- SEO (optional) ---
# Google Search Console verification token
GOOGLE_SITE_VERIFICATION=

# --- PostHog (optional) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Optional first-party proxy (advanced — requires vercel.json rewrites):
# NEXT_PUBLIC_POSTHOG_HOST=/ingest
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
