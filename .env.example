# Copy to .env.local for local testing. Set the same vars in Cloudflare Pages → Settings → Environment variables.

# --- SEO (optional) ---
# Google Search Console verification token
GOOGLE_SITE_VERIFICATION=

# --- PostHog (optional) ---
NEXT_PUBLIC_POSTHOG_KEY=
# Proxied through your domain via public/_redirects (recommended on Cloudflare Pages)
NEXT_PUBLIC_POSTHOG_HOST=/ingest
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# EU cloud alternative:
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
