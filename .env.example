# Optional — the site works without analytics. Copy to .env.local for local testing.

# --- Self-hosted dashboard (/dashboard) ---
# MongoDB Atlas SRV connection string
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/dbname

# Password for /dashboard (also used to sign the auth cookie)
ANALYTICS_DASHBOARD_SECRET=

# Set to "false" to stop sending events to MongoDB when using PostHog only
NEXT_PUBLIC_SELF_HOSTED_ANALYTICS=true

# --- PostHog (optional) ---
NEXT_PUBLIC_POSTHOG_KEY=
# Proxied through your domain to reduce ad-blocker issues (recommended)
NEXT_PUBLIC_POSTHOG_HOST=/ingest
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# EU cloud alternative:
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
